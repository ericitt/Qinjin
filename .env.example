# 复制这个文件为 .env（本地跑 seed 脚本用），Vercel 部署时在项目设置的 Environment Variables 里填一样的值

# Supabase 项目 → Settings → Database → Connection string → 选 "Transaction" 模式（端口6543）
# 形如：postgresql://postgres.xxxxx:[你的密码]@aws-0-xxx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- AI 询价助手 ----
# 大陆自建部署用 DeepSeek：platform.deepseek.com 注册（手机号实名）→ API keys 创建 → 充值
# 支付宝/微信扫码即可，先充 ¥20 够用很久（约 ¥0.002/千token）
DEEPSEEK_API_KEY=sk-你的密钥
# 可选：AI_PROVIDER=deepseek|anthropic（不填会自动按哪个 Key 存在来选）
# AI_PROVIDER=deepseek

# 只有部署在墙外时才用得上；大陆直连不了 api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-你的密钥

# 访问密码（共享密码门禁）。
# 留空 = 门禁关闭，任何人拿到网址都能进；填上之后所有页面和接口都要先登录。
# 只需要在 Vercel 的环境变量里设置，本地跑脚本用不到。
# 改密码会让所有人的登录状态立即失效（签名密钥就是这个密码）。
ACCESS_PASSWORD=
